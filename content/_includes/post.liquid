---
layout: base.liquid
bodyClass: post
---
<h1>{{ title }}</h1>
<p><i><time datetime="{{ page.date | date: "%Y-%m-%d" }}">{{ page.date | bearDate }}</time></i></p>
{{ content }}
<p><a href="mailto:{{ site.email }}?subject=Re: {{ title | escape }}">Reply via email</a></p>
<p class="tags">
  {%- for tag in tags %}{% if tag != "posts" %}
  <a href="/all/?q={{ tag }}">#{{ tag }}</a>
  {%- endif %}{% endfor %}
</p>
