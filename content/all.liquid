---
title: All Posts
permalink: /all/
date: 2026-10-15
updated: 2026-10-15
---
{% assign newestFirst = collections.posts | reverse %}
{% render "post-list.liquid", posts: newestFirst %}

{%- comment -%}
  Filter links for every tag used by a post. /all/?q=blog shows only posts tagged blog
  (the script below hides the rest); without JavaScript the full list still shows.
{%- endcomment -%}
{%- assign tagList = "" %}
{%- for post in collections.posts %}{% for tag in post.data.tags %}{% if tag != "posts" %}
  {%- assign tagList = tagList | append: tag | append: " " %}
{%- endif %}{% endfor %}{% endfor %}
{%- assign tagList = tagList | strip | split: " " | uniq | sort %}
<p class="tags" id="tag-filter">
  {%- for tag in tagList %}
  <a href="/all/?q={{ tag }}" data-tag="{{ tag }}">#{{ tag }}</a>
  {%- endfor %}
  <a href="/all/" id="show-all" hidden>show all</a>
</p>
<script>
  const tag = new URLSearchParams(location.search).get("q");
  if (tag) {
    for (const post of document.querySelectorAll("ul.blog-posts li")) {
      post.hidden = !post.dataset.tags.split(" ").includes(tag);
    }
    for (const link of document.querySelectorAll("#tag-filter [data-tag]")) {
      if (link.dataset.tag === tag) link.setAttribute("aria-current", "page");
    }
    document.getElementById("show-all").hidden = false;
  }
</script>
